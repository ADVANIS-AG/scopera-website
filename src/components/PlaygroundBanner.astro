---
// Selbstbedienungs-Einstieg zur Spielwiese. Bewusst wie der SignupBanner aufgebaut und mit
// derselben Klasse .signup-band, weil beide dieselbe Rolle haben: ohne Termin loslegen.
import { defaultLang, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
interface Props { lang?: Lang; }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
---
<section>
  <div class="wrap">
    <div class="signup-band">
      <div>
        <p class="tag">{t('cta.playground.tag')}</p>
        <h2 style="margin-bottom:10px;">{t('cta.playground.title')}</h2>
        <p class="soft" style="max-width:38em; margin-bottom:0;">{t('cta.playground.text')}</p>
      </div>
      <p style="margin:0;">
        <a class="btn" href={`${base}${lang}/playground/`}>{t('cta.playground.action')}</a>
      </p>
    </div>
  </div>
</section>
