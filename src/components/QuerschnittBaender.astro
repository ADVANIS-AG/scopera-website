---
import { defaultLang, type Lang } from '../i18n/ui';
interface Props { lang?: Lang; }
const { lang = defaultLang } = Astro.props;

const baender = [
  {
    label: { de: 'Trust und Governance', en: 'Trust and Governance' },
    text: {
      de: 'Schweizer Hosting, revDSG und DSGVO, Nachvollziehbarkeit und Modellwahl. Nicht als Hindernis, sondern als Enabler.',
      en: 'Swiss hosting, revFADP and GDPR, traceability and model choice. Not a hurdle, but an enabler.',
    },
    motor: false,
  },
  {
    label: { de: 'Agentic Engineering', en: 'Agentic Engineering' },
    text: {
      de: 'Unsere Delivery Engine: AI-natives Entwickeln auf erprobter Plattform. Der Grund, warum wir liefern, während andere planen.',
      en: 'Our delivery engine: AI-native development on a proven platform. The reason we deliver while others are still planning.',
    },
    motor: true,
  },
  {
    label: { de: 'Sicher und anpassbar', en: 'Secure and adaptable' },
    text: {
      de: 'Kontrollierter Betrieb und laufende Weiterentwicklung durch autorisierte Personen. Jede Änderung ist protokolliert und rücksetzbar.',
      en: 'Controlled operations and ongoing development by authorized people. Every change is logged and reversible.',
    },
    motor: false,
  },
];
---
<div style="display:grid; gap:12px; margin-top:14px;">
  {baender.map(b => (
    <div style={`display:flex; gap:14px; align-items:baseline; flex-wrap:wrap; padding:12px 16px; border:1px solid ${b.motor ? 'var(--accent)' : 'var(--line)'}; border-radius: var(--radius); background:${b.motor ? 'var(--accent)' : 'var(--band)'}; color:${b.motor ? 'var(--accent-ink)' : 'inherit'};`}>
      <strong style="font-size:12px; letter-spacing:.12em; text-transform:uppercase; white-space:nowrap;">{b.label[lang]}</strong>
      <span style="font-size:14px; opacity:.9;">{b.text[lang]}</span>
    </div>
  ))}
</div>
