---
import { stufen } from '../data/stufen';
import StufenKarte from './StufenKarte.astro';
import { defaultLang, type Lang } from '../i18n/ui';
interface Props { lang?: Lang; }
const { lang = defaultLang } = Astro.props;
const gruppe = stufen.slice(0, 2);
const rest = stufen.slice(2);
const gruppeLabel = lang === 'de'
  ? 'Werden meist im selben Zug gebucht'
  : 'Usually booked together';
---
<div class="stufen-band">
  <div class="stufen-gruppe">
    <p class="stufen-gruppe-label">{gruppeLabel}</p>
    <div class="stufen-gruppe-inner">
      {gruppe.map(s => <StufenKarte s={s} lang={lang} />)}
    </div>
  </div>
  <div class="stufen-rest">
    {rest.map(s => <StufenKarte s={s} lang={lang} />)}
  </div>
</div>
