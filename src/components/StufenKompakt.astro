---
import { stufen } from '../data/stufen';
import { defaultLang, type Lang } from '../i18n/ui';
interface Props { lang?: Lang; einordnung: string; aktivPfad: string; }
const { lang = defaultLang, einordnung, aktivPfad } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div class="stufen-kompakt">
  <p class="soft" style="font-size:14px; margin:0;">{einordnung}</p>
  <div class="stufen-kompakt-liste">
    {stufen.map(s => (
      <a href={`${base}${lang}/${s.pfad}`} class={s.pfad === aktivPfad ? 'aktiv' : ''}>{s.nr}. {s.titel[lang]}</a>
    ))}
  </div>
</div>
