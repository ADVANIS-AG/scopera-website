---
import IconBaton from './icons/IconBaton.astro';
import IconStaff from './icons/IconStaff.astro';
import IconResonance from './icons/IconResonance.astro';
import IconTogether from './icons/IconTogether.astro';

const saeulen = [
  { titel: 'Strategy', Icon: IconBaton, punkte: ['AI Strategy', 'Assessments', 'Roadmaps', 'Governance by Design'] },
  { titel: 'Enterprise AI Platform', Icon: IconStaff, punkte: ['AI Agents', 'Workflows', 'Knowledge', 'Integrationen und Analytics'] },
  { titel: 'Managed AI', Icon: IconResonance, punkte: ['Monitoring', 'Operational Intelligence', 'Support', 'AI Lifecycle'] },
  { titel: 'Enablement', Icon: IconTogether, punkte: ['Training', 'Change und Adoption', 'Customer Experience', 'Employee Experience'] },
];
---
<div class="karten">
  {saeulen.map(s => (
    <div class="karte" style="border-top: 4px solid var(--ink);">
      <s.Icon />
      <h3>{s.titel}</h3>
      <ul>{s.punkte.map(p => <li>{p}</li>)}</ul>
    </div>
  ))}
</div>
