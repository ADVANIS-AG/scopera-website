---
import '../styles/global.css';
import { SITE_NAME, BOOKING_URL, PLAUSIBLE_DOMAIN, WORKER_ENDPOINT, ADRESSE } from '../config';
import { defaultLang, type UiKey, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import CookieBanner from '../components/CookieBanner.astro';
interface Props { title: string; description: string; image?: string; }
const { title, description, image = 'bilder/social-share.jpg' } = Astro.props;
const base = import.meta.env.BASE_URL;
const lang = (Astro.currentLocale as Lang | undefined) ?? defaultLang;
const t = useTranslations(lang);
const otherLang = lang === 'de' ? 'en' : 'de';
const rest = Astro.url.pathname.slice((base + lang + '/').length);
const otherLangHref = `${base}${otherLang}/${rest}`;
const terminZiel = BOOKING_URL || `${base}${lang}/contact`;
const [strasse, ortMitPlz] = ADRESSE.split(', ');
const plz = ortMitPlz?.match(/^\d+/)?.[0];
const ort = ortMitPlz?.replace(/^\d+\s*/, '');
const nav: [string, UiKey][] = [
  ['services', 'nav.services'],
  ['product', 'nav.product'],
  ['editions', 'nav.packages'],
  ['partner', 'nav.partner'],
  ['insights', 'nav.insights'],
  ['faq', 'nav.faq'],
  ['about', 'nav.about'],
];
---
<!doctype html>
<html lang={lang === 'de' ? 'de-CH' : 'en'}>
<head>
  <!-- Google Tag Manager: laedt erst nach Einwilligung im Cookie-Banner (siehe CookieBanner.astro) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'analytics_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied'
    });
    window.scoperaLoadGTM = function () {
      if (window.scoperaGtmLoaded) return;
      window.scoperaGtmLoaded = true;
      gtag('consent', 'update', {
        'ad_storage': 'granted',
        'analytics_storage': 'granted',
        'ad_user_data': 'granted',
        'ad_personalization': 'granted'
      });
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-TN7M9RD6');
    };
  </script>
  <!-- End Google Tag Manager -->
  <script is:inline>
    (function () {
      try {
        if (localStorage.getItem('scopera_theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
        }
      } catch (e) {}
    })();
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
  <link rel="icon" type="image/png" sizes="512x512" href={`${base}favicon.png`} />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_US'} />
  <meta property="og:image" content={new URL(`${base}${image}`, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(`${base}${image}`, Astro.site)} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="alternate" hreflang="de" href={new URL(`${base}de/${rest}`, Astro.site)} />
  <link rel="alternate" hreflang="en" href={new URL(`${base}en/${rest}`, Astro.site)} />
  <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />
  {PLAUSIBLE_DOMAIN && <script is:inline defer data-domain={PLAUSIBLE_DOMAIN} src="https://plausible.io/js/script.js"></script>}
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: new URL(`${base}${lang}/`, Astro.site).toString(),
    sameAs: ['https://www.advanis.ch'],
    description: t('org.description'),
    address: {
      '@type': 'PostalAddress',
      streetAddress: strasse,
      postalCode: plz,
      addressLocality: ort,
      addressCountry: 'CH',
    },
  })} />
</head>
<body>
  <header class="site">
    <div class="nav">
      <a class="wortmarke" href={`${base}${lang}/`}><img src={`${base}favicon.png`} alt="" width="28" height="28" />{SITE_NAME}<span class="dot">.</span></a>
      <div class="nav-right">
        <ul class="nav-links" id="nav-links">
          {nav.map(([href, key]) => <li><a href={`${base}${lang}/${href}`}>{t(key)}</a></li>)}
          <li><a class="btn" href={terminZiel} target={BOOKING_URL ? '_blank' : undefined} rel={BOOKING_URL ? 'noopener noreferrer' : undefined}>{t('nav.book')}</a></li>
        </ul>
        <a class="lang-toggle" href={otherLangHref} aria-label={t('lang.toggle')}>{otherLang.toUpperCase()}</a>
        <button class="theme-toggle" type="button" aria-label={t('theme.toggle')}>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
        </button>
        <button class="burger" aria-expanded="false" aria-controls="nav-links">{t('nav.menu')}</button>
      </div>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site">
    <div class="wrap">
      <nav>
        {nav.map(([href, key]) => <a href={`${base}${lang}/${href}`}>{t(key)}</a>)}
        <a href={`${base}${lang}/contact`}>{t('nav.contact')}</a>
        <a href={`${base}${lang}/imprint`}>{t('nav.imprint')}</a>
        <a href={`${base}${lang}/privacy`}>{t('nav.privacy')}</a>
        <a href="#" id="cookie-settings-link">{t('cookie.settings')}</a>
      </nav>
      <p class="absender">{SITE_NAME} — {t('footer.absender')} <a href="https://www.advanis.ch" target="_blank" rel="noopener noreferrer">ADVANIS</a>. {t('footer.claim')}</p>
    </div>
  </footer>
  <script>
    const b = document.querySelector('.burger');
    const l = document.getElementById('nav-links');
    b?.addEventListener('click', () => {
      const offen = l?.classList.toggle('offen');
      b.setAttribute('aria-expanded', String(!!offen));
    });

    const themeToggle = document.querySelector('.theme-toggle');
    themeToggle?.addEventListener('click', () => {
      const istHell = document.documentElement.dataset.theme === 'light';
      if (istHell) {
        delete document.documentElement.dataset.theme;
      } else {
        document.documentElement.dataset.theme = 'light';
      }
      try {
        localStorage.setItem('scopera_theme', istHell ? 'dark' : 'light');
      } catch (e) {}
    });
  </script>
  <script>
    // Parallax auf den Hero-Bildern - respektiert prefers-reduced-motion vollstaendig (siehe Plan).
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const bilder = document.querySelectorAll<HTMLImageElement>('.hero-bild img');
      if (bilder.length) {
        const sichtbar = new Set<HTMLImageElement>();
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            const el = entry.target as HTMLImageElement;
            if (entry.isIntersecting) sichtbar.add(el);
            else sichtbar.delete(el);
          });
        }, { rootMargin: '20% 0px' });
        bilder.forEach((img) => io.observe(img));

        let ticking = false;
        const FAKTOR = 0.18;
        function update() {
          ticking = false;
          sichtbar.forEach((img) => {
            const rect = img.getBoundingClientRect();
            const offset = (rect.top + rect.height / 2 - window.innerHeight / 2) * FAKTOR;
            img.style.transform = `scale(1.15) translateY(${offset.toFixed(1)}px)`;
          });
        }
        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        }, { passive: true });
        update();
      }
    }
  </script>
  <CookieBanner lang={lang} />
  {WORKER_ENDPOINT && (
    <script is:inline define:vars={{ workerEndpoint: WORKER_ENDPOINT, base }}>
      (function () {
        var path = location.pathname.startsWith(base) ? '/' + location.pathname.slice(base.length) : location.pathname;
        path = path.replace(/\/+$/, '') || '/';

        var sessionId = sessionStorage.getItem('scopera_sid');
        if (!sessionId) {
          sessionId = crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2);
          sessionStorage.setItem('scopera_sid', sessionId);
        }

        var start = performance.now();
        var sent = false;
        function send() {
          if (sent) return;
          sent = true;
          var durationMs = Math.round(performance.now() - start);
          var payload = JSON.stringify({ sessionId: sessionId, path: path, durationMs: durationMs });
          if (navigator.sendBeacon) {
            navigator.sendBeacon(workerEndpoint + '/beacon', new Blob([payload], { type: 'application/json' }));
          } else {
            fetch(workerEndpoint + '/beacon', { method: 'POST', body: payload, headers: { 'Content-Type': 'application/json' }, keepalive: true });
          }
        }

        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'hidden') send();
        });
        window.addEventListener('pagehide', send);
      })();
    </script>
  )}
</body>
</html>
