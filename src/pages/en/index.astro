---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonaGrid from '../../components/PersonaGrid.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import HeroBild from '../../components/HeroBild.astro';
import KlangLinie from '../../components/KlangLinie.astro';
import VertrauensLeiste from '../../components/VertrauensLeiste.astro';
import StufenBand from '../../components/StufenBand.astro';
import Wegweiser from '../../components/Wegweiser.astro';
import IconFermate from '../../components/icons/IconFermate.astro';
import IconAccelerando from '../../components/icons/IconAccelerando.astro';
import IconBalance from '../../components/icons/IconBalance.astro';
const base = import.meta.env.BASE_URL;
const lang = 'en';
---
<BaseLayout title="SCOPERA. | AI solutions that just work" description="AI solutions for companies in Switzerland and DACH: from strategy to day-to-day operations. First results in hours, production in weeks, not months. SCOPERA — powered by ADVANIS.">
  <section style="padding: 96px 0 72px; border-bottom: none;">
    <div class="wrap">
      <p class="eyebrow">The platform for your own business processes</p>
      <h1>Software that understands how you actually work<span class="dot">.</span></h1>
      <p class="lede">Results within hours, production within weeks, not months. Your business processes become AI applications on a secured platform. Book consulting alongside it, or independently of it.</p>
      <p style="display:flex; gap:12px; flex-wrap:wrap; margin-top:26px;">
        <a class="btn" href={`${base}en/contact`}>Book a call</a>
        <a class="btn-ghost" href={`${base}en/product`}>What's already running on the platform</a>
      </p>
      <div style="margin-top:36px; padding-top:26px; border-top:1px solid var(--line);">
        <VertrauensLeiste lang={lang} />
      </div>
    </div>
  </section>

  <HeroBild src={`${base}bilder/hero-start.jpg`} alt="Gilded dome ceiling of a historic opera house with chandelier and tiers of boxes" />

  <section>
    <div class="wrap">
      <p class="eyebrow">In five stages</p>
      <h2>How you get to your solution.</h2>
      <p class="soft" style="max-width:46em;">Depending on how mature your initiative already is, you can enter at any stage — not necessarily at stage 1.</p>
      <StufenBand lang={lang} />
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Your entry point</p>
      <h2>Where are you right now?</h2>
      <Wegweiser lang={lang} />
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Who it's for</p>
      <h2>Who benefits most in your company.</h2>
      <PersonaGrid lang={lang} />
      <p class="soft" style="margin-top:18px; font-size:14px;">Are you a provider or reseller? <a href={`${base}en/partner`}>More on the white-label model →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Why SCOPERA</p>
      <h2>Fast. Cost-effective. Secure and adaptable. You no longer have to choose.</h2>
      <div class="karten-3">
        <div class="karte">
          <IconAccelerando />
          <h3>Fast<span class="dot">.</span></h3>
          <p style="font-size:14px;" class="soft">First visible results within hours. Working prototype within days. Production application for simple use cases from one to two weeks, typically within two to six weeks.</p>
        </div>
        <div class="karte">
          <IconBalance />
          <h3>Cost-effective<span class="dot">.</span></h3>
          <p style="font-size:14px;" class="soft">Short project timelines and no classic per-user license spiral.</p>
        </div>
        <div class="karte">
          <IconFermate />
          <h3>Secure and adaptable<span class="dot">.</span></h3>
          <p style="font-size:14px;" class="soft">Controlled operations and ongoing development by authorized people.</p>
        </div>
      </div>
    </div>
  </section>


  <section style="padding: 40px 0;">
    <div class="wrap">
      <p style="font-size:18px; max-width:46em; border-left:4px solid var(--accent); padding-left:20px; margin:0;">The same people who have delivered CRM and ERP projects for over 300 Swiss companies since 1997 are building SCOPERA.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Proof, not promises</p>
      <h2>Already running. At companies like yours.</h2>
      <div class="karten-2">
        <div class="karte">
          <span class="tag">Case study</span>
          <h3>Security technology: replaced D365 project module</h3>
          <p style="font-size:14px;" class="soft">A Swiss security technology company now manages projects, quotes and service assignments in a custom-built app. Built in days, integrated with Dynamics 365.</p>
        </div>
        <div class="karte">
          <span class="tag">Platform</span>
          <h3>Enterprise AI Platform</h3>
          <p style="font-size:14px;" class="soft">Multi-tenant, AI gateway, white-label capable, revFADP- and GDPR-ready. The foundation every one of our solutions is built on.</p>
        </div>
      </div>
      <p style="margin-top:18px;"><a href={`${base}en/product`}>To the product and all solutions →</a></p>
    </div>
  </section>

  <section style="border-bottom: none; padding: 56px 0 0;">
    <div class="wrap"><KlangLinie /></div>
  </section>

  <CtaBanner lang={lang} titel="Let's talk about your first use case." text="30 minutes is enough to find out where AI has the fastest impact in your company. No obligation, concrete, at eye level." />
</BaseLayout>
