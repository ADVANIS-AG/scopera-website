---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { KONTAKT_EMAIL, TELEFON, WORKER_ENDPOINT, TURNSTILE_SITE_KEY, BOOKING_URL } from '../../config';
import HeroBild from '../../components/HeroBild.astro';
const formularAktiv = WORKER_ENDPOINT.length > 0;
const emailAktiv = !KONTAKT_EMAIL.startsWith('PLATZHALTER');
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Contact | SCOPERA." description="Book a call or send a message: the first step toward your AI solution takes 30 minutes.">
  <section style="padding: 88px 0 64px; border-bottom: none;">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Let's talk<span class="dot">.</span></h1>
      <p class="lede">30 minutes is enough for an honest assessment: what's possible, roughly what it costs, how fast it can go. No obligation.</p>
    </div>
  </section>
  <HeroBild src={`${base}bilder/hero-kontakt.jpg`} alt="Gilded opera boxes with guests, warmly lit" />
  <section style="border-bottom: none; padding-bottom: 0;">
    <div class="wrap">
      <p style="font-size:17px; font-weight:600; max-width:46em;">Bring the business process that's bothering you. Together we'll check how SCOPERA can digitize it.</p>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="karten-3">
        <div class="karte" style="padding: 26px;">
          <h3>Book a call</h3>
          <p style="font-size:14px;" class="soft">The most direct way: pick a time that works for you.</p>
          {BOOKING_URL
            ? <a class="btn" href={BOOKING_URL}>Choose a time</a>
            : <p class="soft" style="font-size:14px;"><strong>Online booking coming soon.</strong> Until then, reach us via the form{emailAktiv ? ' or by email' : ''}.</p>}
        </div>
        <div class="karte" style="padding: 26px;">
          <h3>Call us</h3>
          <p style="font-size:14px;" class="soft">Mon–Fri, 8am–6pm CET.</p>
          <a class="btn" href={`tel:${TELEFON.replace(/\s+/g, '')}`}>{TELEFON}</a>
        </div>
        <div id="nachricht-schreiben" class="karte" style="padding: 26px;">
          <h3>Send a message</h3>
          {formularAktiv ? (
            <>
              {TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
              <form id="kontakt-form" style="display:grid; gap:12px;">
                <label style="font-size:13px; font-weight:600;">Name<br /><input name="name" required style="width:100%; padding:10px; border:1px solid var(--line); background:var(--ground); color:var(--ink); font:inherit;" /></label>
                <label style="font-size:13px; font-weight:600;">Company<br /><input name="firma" style="width:100%; padding:10px; border:1px solid var(--line); background:var(--ground); color:var(--ink); font:inherit;" /></label>
                <label style="font-size:13px; font-weight:600;">Email<br /><input name="email" type="email" required style="width:100%; padding:10px; border:1px solid var(--line); background:var(--ground); color:var(--ink); font:inherit;" /></label>
                <label style="font-size:13px; font-weight:600;">Message<br /><textarea name="nachricht" rows="5" required style="width:100%; padding:10px; border:1px solid var(--line); background:var(--ground); color:var(--ink); font:inherit;"></textarea></label>
                {TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>}
                <button class="btn" type="submit" style="border:none; cursor:pointer;">Send</button>
                <p id="kontakt-status" class="soft" style="font-size:14px;" hidden></p>
              </form>
              <script is:inline define:vars={{ workerEndpoint: WORKER_ENDPOINT }}>
                const form = document.getElementById('kontakt-form');
                const status = document.getElementById('kontakt-status');
                form?.addEventListener('submit', async (event) => {
                  event.preventDefault();
                  const button = form.querySelector('button[type="submit"]');
                  const data = new FormData(form);
                  const turnstileToken = data.get('cf-turnstile-response') || '';
                  const payload = {
                    name: data.get('name'),
                    firma: data.get('firma'),
                    email: data.get('email'),
                    nachricht: data.get('nachricht'),
                    turnstileToken,
                  };
                  button.setAttribute('disabled', 'true');
                  status.hidden = true;
                  try {
                    const res = await fetch(workerEndpoint + '/contact', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify(payload),
                    });
                    const result = await res.json().catch(() => ({}));
                    if (res.ok && result.ok) {
                      form.reset();
                      status.textContent = "Thanks for your message. We'll be in touch shortly.";
                    } else {
                      status.textContent = "That didn't work, unfortunately. Please try again or write to us directly.";
                    }
                  } catch {
                    status.textContent = "That didn't work, unfortunately. Please try again or write to us directly.";
                  } finally {
                    button.removeAttribute('disabled');
                    status.hidden = false;
                  }
                });
              </script>
            </>
          ) : (
            <p class="soft" style="font-size:14px;"><strong>The form is currently being set up.</strong> {emailAktiv ? <>Write to us directly: <a href={`mailto:${KONTAKT_EMAIL}`}>{KONTAKT_EMAIL}</a></> : 'Contact details coming soon.'}</p>
          )}
        </div>
      </div>
      {emailAktiv && <p class="soft" style="margin-top:18px; font-size:14px;">Or directly by email: <a href={`mailto:${KONTAKT_EMAIL}`}>{KONTAKT_EMAIL}</a></p>}
    </div>
  </section>
  <section>
    <div class="wrap">
      <p class="eyebrow">Agenda</p>
      <h2>What happens in the 30 minutes.</h2>
      <div class="karten-3" style="margin-bottom:26px;">
        <div class="karte">
          <p class="tag">10 minutes</p>
          <p style="font-size:14px;" class="soft">You describe the business process that's bothering you.</p>
        </div>
        <div class="karte">
          <p class="tag">10 minutes</p>
          <p style="font-size:14px;" class="soft">We show what already exists on the platform for it.</p>
        </div>
        <div class="karte">
          <p class="tag">10 minutes</p>
          <p style="font-size:14px;" class="soft">Assessment of feasibility, timeline and cost range.</p>
        </div>
      </div>
      <div class="karten-2">
        <div class="karte">
          <h3>Afterward</h3>
          <p style="font-size:14px;" class="soft">You'll get a written short assessment with rough costs within two business days. Whether it continues is up to you.</p>
        </div>
        <div class="karte">
          <h3>Who's there</h3>
          <div style="display:flex; align-items:center; gap:12px;">
            <div aria-hidden="true" style="flex-shrink:0; width:44px; height:44px; border:1px solid var(--line); background: var(--band); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:17px;">S</div>
            <p style="font-size:14px; margin:0;" class="soft">Sven Brenner, CTO and AI Strategist</p>
          </div>
        </div>
      </div>
      <p class="soft" style="font-size:13px; margin-top:18px;">Useful, if you have one: a process description or a sample document.</p>
    </div>
  </section>
</BaseLayout>
