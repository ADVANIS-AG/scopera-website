---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import HeroBild from '../../../components/HeroBild.astro';
const artikel = (await getCollection('insightsEn')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const datumFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Insights | SCOPERA." description="Straight talk about AI in business: what works, what doesn't, and how to tell the difference.">
  <section style="padding: 88px 0 64px; border-bottom: none;">
    <div class="wrap">
      <p class="eyebrow">Insights</p>
      <h1>Straight talk about AI<span class="dot">.</span></h1>
      <p class="lede">No trends, no panic. What actually works in Swiss companies.</p>
    </div>
  </section>
  <HeroBild src={`${base}bilder/hero-insights.jpg`} alt="Black-and-white photo of an orchestra on stage in a large concert hall" />
  <section>
    <div class="wrap">
      {artikel.map(a => (
        <article style="padding: 22px 0; border-top: 1px solid var(--line);">
          <p class="eyebrow">{datumFmt.format(a.data.pubDate)}</p>
          <h2 style="margin: 6px 0 8px;"><a href={`${base}en/insights/${a.id.replace(/\.md$/, '')}`} style="text-decoration:none;">{a.data.title}</a></h2>
          <p class="soft" style="max-width: 46em;">{a.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
