---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
const faq = [
  { id: 'tempo', f: 'How fast does this really go?', a: 'You see first visible results within hours, a working prototype within days. The production application follows for simple use cases from one to two weeks, typically within two to six weeks, depending on scope and integrations. You see interim progress from day one instead of status reports.' },
  { id: 'lizenz', f: 'Am I locked into a license?', a: 'No. You choose editions based on need, adjustable up or down every month. No annual contracts, no license straitjacket.' },
  { id: 'code', f: 'Who owns the code?', a: 'Your technical expertise stays with you. Custom development becomes your property. You use the platform under a license, and under your own brand with the white-label option.' },
  { id: 'daten', f: 'Where does our data live?', a: 'In Switzerland by default. On your own cloud or on-premises if you prefer. We choose and document the model together (Swiss and European providers included).' },
  { id: 'it', f: 'Do you replace our IT?', a: 'No, we complement it. We integrate into existing systems and hand over in a way that lets your IT weigh in and take over at any time.' },
  { id: 'agentic', f: 'What is Agentic Engineering?', a: "Our way of working: we develop with AI, on a proven platform, in short cycles with daily visible progress. You don't need to know the term. You'll notice it in the pace." },
  { id: 'weiterentwicklung', f: 'Who develops the solution further after go-live?', a: 'You decide. Operations, security and monitoring are on us. You handle further development in your own department, without being a software developer, or you hand it to us. Both are possible and changeable at any time.' },
  { id: 'kosten', f: "What does it cost to get started?", a: 'The trial license is free and comes with no obligation. For Starter, Pro and Enterprise we put together a quote that matches your scope and seat requirements. Assessments and workshops have fixed prices, agreed before we start.' },
  { id: 'automatisch', f: 'Does our solution change on its own?', a: 'No. SCOPERA identifies potential improvements and suggests them. Authorized people on your side decide what gets implemented. Every change is logged and reversible.' },
];
const lang = 'en';
---
<BaseLayout title="FAQ | SCOPERA." description="Frequently asked questions about SCOPERA: pace, licensing model, code ownership, data location, IT integration and Agentic Engineering, answered clearly.">
  <section style="padding: 88px 0 64px; border-bottom: none;">
    <div class="wrap">
      <p class="eyebrow">FAQ</p>
      <h1>Straight talk<span class="dot">.</span></h1>
      <p class="lede">The questions we hear most often, answered honestly. Missing something? Write to us.</p>
    </div>
  </section>
  <section>
    <div class="wrap" style="max-width: 760px;">
      {faq.map(item => (
        <details id={item.id} style="border-top: 1px solid var(--line); padding: 14px 0; scroll-margin-top: 90px;">
          <summary style="font-weight: 700; cursor: pointer; font-size: 17px;">{item.f}</summary>
          <p class="soft" style="margin-top: 10px; max-width: 46em;">{item.a}</p>
        </details>
      ))}
    </div>
  </section>
  <CtaBanner lang={lang} titel="Question not covered?" text="Write to us directly or book 30 minutes. We answer honestly, even when the answer is 'no'." />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(item => ({
      '@type': 'Question',
      name: item.f,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  })} />
</BaseLayout>
