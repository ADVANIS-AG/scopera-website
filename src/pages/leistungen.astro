---
import BaseLayout from '../layouts/BaseLayout.astro';
import SaeulenGrid from '../components/SaeulenGrid.astro';
import QuerschnittBaender from '../components/QuerschnittBaender.astro';
import CtaBanner from '../components/CtaBanner.astro';
import HeroBild from '../components/HeroBild.astro';
import KlangLinie from '../components/KlangLinie.astro';
import IconMagnify from '../components/icons/IconMagnify.astro';
import IconTuningFork from '../components/icons/IconTuningFork.astro';
import IconTogether from '../components/icons/IconTogether.astro';
import IconSpark from '../components/icons/IconSpark.astro';
import { BOOKING_URL } from '../config';

// Zuordnung Angebot -> Ansprechperson + individueller Buchungslink. Aktuell Platzhalter, siehe
// README-Launch-Checkliste. `bookingUrl` leer = CTA faellt auf den allgemeinen Buchungslink zurueck,
// `name`, der mit "PLATZHALTER" beginnt, wird nicht angezeigt (gleiches Muster wie src/config.ts).
// Gleiche Form laesst sich 1:1 auf /pakete oder weitere Seiten uebertragen.
const angebote = [
  {
    titel: 'KI Potenzial Assessment',
    Icon: IconMagnify,
    bild: 'leistungen-assessment.jpg',
    alt: 'Hände spielen Klavier, im Hintergrund ein aufgeschlagenes Notenheft',
    text: 'Wir schauen uns Ihre Prozesse an und zeigen konkret, wo AI den grössten Hebel hat — mit Aufwand-Wirkung-Einschätzung, nicht mit Buzzwords. In einem halben Tag erhalten Sie eine priorisierte Liste möglicher Use Cases samt grober Aufwandschätzung.',
    ctaText: 'Assessment anfragen',
    kontakt: { name: 'PLATZHALTER_NAME_ASSESSMENT', rolle: 'PLATZHALTER_ROLLE_ASSESSMENT', bookingUrl: '' },
  },
  {
    titel: 'AI Readiness Assessment',
    Icon: IconTuningFork,
    bild: 'leistungen-readiness.jpg',
    alt: 'Eine Geige liegt bereit auf verwitterten Holzdielen',
    text: 'Sind Ihre Daten, Systeme und Prozesse bereit für AI? Wir prüfen ehrlich, was heute schon geht und was zuerst aufgeräumt werden muss. Am Ende steht ein klarer Massnahmenplan, keine Grundsatzdiskussion.',
    ctaText: 'Bereitschaft prüfen lassen',
    kontakt: { name: 'PLATZHALTER_NAME_READINESS', rolle: 'PLATZHALTER_ROLLE_READINESS', bookingUrl: '' },
  },
  {
    titel: 'AI Strategie Workshop',
    Icon: IconTogether,
    bild: 'leistungen-workshop.jpg',
    alt: 'Geigerinnen und Geiger spielen im Ensemble, Hände und Instrumente im Zusammenspiel',
    text: 'Ein Tag, ein Raum, eine Roadmap: Wir erarbeiten gemeinsam mit Ihrem Team, welche AI-Initiativen zuerst Sinn ergeben. Sie verlassen den Workshop mit einer priorisierten Liste und einem realistischen Zeitplan, nicht mit einer Präsentation.',
    ctaText: 'Workshop buchen',
    kontakt: { name: 'PLATZHALTER_NAME_WORKSHOP', rolle: 'PLATZHALTER_ROLLE_WORKSHOP', bookingUrl: '' },
  },
  {
    titel: 'Vibe your Issue',
    Icon: IconSpark,
    bild: 'leistungen-vibe.jpg',
    alt: 'Saxophon in dynamischem Bühnenlicht, warme Farben',
    text: 'Bringen Sie ein konkretes Problem mit, wir lösen es live mit AI-nativer Entwicklung — Sie sehen in Stunden, nicht Wochen, ob und wie es geht. Kein Angebot, keine Vorlaufzeit: wir setzen uns hin und probieren es.',
    ctaText: 'Issue einreichen',
    kontakt: { name: 'PLATZHALTER_NAME_VIBE', rolle: 'PLATZHALTER_ROLLE_VIBE', bookingUrl: '' },
  },
];
const ablauf = [
  ['Verstehen', 'Wir hören zu, schauen uns Ihre Prozesse an und finden den Use Case mit dem besten Verhältnis von Aufwand zu Wirkung.'],
  ['Bauen', 'AI-natives Entwickeln auf unserer Plattform: erster funktionierender Stand in Tagen, produktive Lösung in Wochen.'],
  ['Betreiben', 'Monitoring, Support und Governance im laufenden Betrieb. Verlässlich und messbar.'],
  ['Weiterentwickeln', 'Ihre Lösung lernt dazu: neue Anforderungen, neue Modelle, neue Möglichkeiten, laufend integriert.'],
];
const base = import.meta.env.BASE_URL;
const terminZielFallback = BOOKING_URL || `${base}kontakt`;
---
<BaseLayout title="Leistungen | SCOPERA." description="Beratung, die auch ohne unsere Plattform trägt: Assessments, Workshops und Formate, die Klarheit schaffen, bevor Sie investieren.">
  <section style="padding: 88px 0 64px; border-bottom: none;">
    <div class="wrap">
      <p class="eyebrow">Leistungen</p>
      <h1>Beratung, die auch ohne unsere Plattform trägt<span class="dot">.</span></h1>
      <p class="lede">Strategie, Assessments, Workshops: Sie können unsere Beratung parallel zur Plattform nutzen oder unabhängig davon buchen. Beides schafft Klarheit, bevor Sie investieren.</p>
    </div>
  </section>
  <HeroBild src={`${base}bilder/hero-leistungen.jpg`} alt="Sinfonieorchester spielt vor vollem Konzertsaal, Blick von der Bühne auf das Publikum" />
  <section>
    <div class="wrap">
      <SaeulenGrid />
      <QuerschnittBaender />
    </div>
  </section>
  <section>
    <div class="wrap">
      <p class="eyebrow">Unsere Beratungsformate</p>
      <h2>Vier Wege, konkret zu werden.</h2>
      <div class="split-reihen">
        {angebote.map(a => (
          <div class="split-reihe">
            <div class="split-bild">
              <img src={`${base}bilder/${a.bild}`} alt={a.alt} loading="lazy" />
            </div>
            <div class="split-text">
              <a.Icon />
              <h3>{a.titel}<span class="dot">.</span></h3>
              <p class="soft" style="font-size:14px;">{a.text}</p>
              {!a.kontakt.name.startsWith('PLATZHALTER') && (
                <p class="soft" style="font-size:12px; margin-top:2px;">Ansprechperson: {a.kontakt.name}{a.kontakt.rolle && !a.kontakt.rolle.startsWith('PLATZHALTER') ? `, ${a.kontakt.rolle}` : ''}</p>
              )}
              <p style="margin-top:16px;">
                <a class="btn" href={a.kontakt.bookingUrl || terminZielFallback}>{a.ctaText} →</a>
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section>
    <div class="wrap">
      <p class="eyebrow">So arbeiten wir</p>
      <h2>Vier Schritte. Kein Wasserfall.</h2>
      <div style="margin: 8px 0 26px;"><KlangLinie /></div>
      <div class="karten">
        {ablauf.map(([t, x], i) => (
          <div class="karte">
            <p class="tag">Schritt {i + 1}</p>
            <h3>{t}</h3>
            <p style="font-size:14px;" class="soft">{x}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <CtaBanner titel="Welcher Use Case zuerst?" text="Bringen Sie einen Prozess mit, der Sie nervt. Wir sagen Ihnen in 30 Minuten, ob und wie schnell AI ihn übernehmen kann." />
</BaseLayout>
