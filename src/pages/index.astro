---
import BaseLayout from '../layouts/BaseLayout.astro';
import SaeulenGrid from '../components/SaeulenGrid.astro';
import PersonaGrid from '../components/PersonaGrid.astro';
import QuerschnittBaender from '../components/QuerschnittBaender.astro';
import CtaBanner from '../components/CtaBanner.astro';
import HeroBild from '../components/HeroBild.astro';
import KlangLinie from '../components/KlangLinie.astro';
import IconFermate from '../components/icons/IconFermate.astro';
import IconAccelerando from '../components/icons/IconAccelerando.astro';
import IconBalance from '../components/icons/IconBalance.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="SCOPERA. | AI-Lösungen, die einfach laufen" description="AI-Lösungen für Unternehmen in der Schweiz und DACH: von der Strategie bis zum laufenden Betrieb. Geliefert in Wochen, nicht Monaten. SCOPERA — powered by ADVANIS.">
  <section style="padding: 96px 0 72px; border-bottom: none;">
    <div class="wrap">
      <p class="eyebrow">AI für Schweizer und DACH-Unternehmen</p>
      <h1>AI-Lösungen, die einfach laufen<span class="dot">.</span></h1>
      <p class="lede">Wir bauen intelligente Anwendungen für Unternehmen in der Schweiz und DACH, die keine grosse IT-Abteilung und keine Lust auf monatelange IT-Projekte haben. Individuell entwickelt in Wochen, oder als bewährte Lösung sofort einsatzbereit.</p>
      <p style="display:flex; gap:12px; flex-wrap:wrap; margin-top:26px;">
        <a class="btn" href={`${base}kontakt`}>Termin buchen</a>
        <a class="btn-ghost" href={`${base}produkt`}>Was wir gebaut haben</a>
      </p>
      <div class="stat-bar">
        <div class="stat"><strong>28</strong><span>Jahre Erfahrung</span></div>
        <div class="stat"><strong>300+</strong><span>Unternehmen begleitet</span></div>
        <div class="stat"><strong>ADVANIS</strong><span>Schweizer Beratungsunternehmen</span></div>
        <div class="stat"><strong>CH</strong><span>Hosting in der Schweiz, auf Wunsch weltweit</span></div>
      </div>
    </div>
  </section>

  <HeroBild src={`${base}bilder/hero-start.jpg`} alt="Vergoldete Kuppeldecke eines historischen Opernhauses mit Kronleuchter und Rängen" />

  <section>
    <div class="wrap">
      <p class="eyebrow">Für wen</p>
      <h2>Wer in Ihrem Unternehmen profitiert.</h2>
      <PersonaGrid />
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Warum SCOPERA</p>
      <h2>Verlässlich. Schnell. Wirtschaftlich. Sie müssen nicht mehr wählen.</h2>
      <div class="karten-3">
        <div class="karte">
          <IconFermate />
          <h3>Verlässlich<span class="dot">.</span></h3>
          <p style="font-size:14px;" class="soft">Schweizer Hosting, DSG/DSGVO-konform, nachvollziehbare Modellwahl. Und ein Partner, der nach dem Go-live nicht verschwindet.</p>
        </div>
        <div class="karte">
          <IconAccelerando />
          <h3>Schnell<span class="dot">.</span></h3>
          <p style="font-size:14px;" class="soft">Wir entwickeln AI-nativ auf einer erprobten Plattform. Was andere in Monaten planen, steht bei uns in Wochen im Betrieb.</p>
        </div>
        <div class="karte">
          <IconBalance />
          <h3>Wirtschaftlich<span class="dot">.</span></h3>
          <p style="font-size:14px;" class="soft">Weniger Aufwand pro Lösung heisst tiefere Kosten. Sie zahlen für Ergebnisse, nicht für Konzeptpapiere.</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Was wir tun</p>
      <h2>Von der Strategie bis zum kontinuierlich lernenden AI-Betrieb.</h2>
      <SaeulenGrid />
      <QuerschnittBaender />
      <p style="margin-top:18px;"><a href={`${base}leistungen`}>Alle Leistungen im Detail →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Beweise statt Versprechen</p>
      <h2>Läuft bereits. Bei Unternehmen wie Ihrem.</h2>
      <div class="karten-2">
        <div class="karte">
          <span class="tag">Fallbeispiel</span>
          <h3>Sicherheitstechnik: D365-Projektmodul ersetzt</h3>
          <p style="font-size:14px;" class="soft">Ein Schweizer Sicherheitstechnik-Unternehmen steuert Projekte, Offerten und Service-Einsätze jetzt in einer massgeschneiderten App. Gebaut in Tagen, integriert mit Dynamics 365.</p>
        </div>
        <div class="karte">
          <span class="tag">Plattform</span>
          <h3>Enterprise AI Platform</h3>
          <p style="font-size:14px;" class="soft">Multi-Tenant, AI-Gateway, White-Label-fähig, DSG/DSGVO-ready. Das Fundament, auf dem jede unserer Lösungen steht.</p>
        </div>
      </div>
      <p style="margin-top:18px;"><a href={`${base}produkt`}>Zum Produkt und allen Lösungen →</a></p>
    </div>
  </section>

  <section style="border-bottom: none; padding: 56px 0 0;">
    <div class="wrap"><KlangLinie /></div>
  </section>

  <CtaBanner titel="Reden wir über Ihren ersten Use Case." text="30 Minuten genügen, um herauszufinden, wo AI in Ihrem Unternehmen am schnellsten Wirkung zeigt. Unverbindlich, konkret, auf Augenhöhe." />
</BaseLayout>
