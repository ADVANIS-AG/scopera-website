---
import { SITE_NAME } from '../config';
const base = import.meta.env.BASE_URL;
// Sprachweiche. Sie leitet Besuchende sofort weiter, ist aber bewusst indexierbar:
// hreflang x-default und der Sitemap-Eintrag zeigen auf diese URL, ein noindex waere
// dazu ein Widerspruch. Die Meta-Daten sorgen ausserdem dafuer, dass eine geteilte
// Verlinkung auf scopera.ai eine brauchbare Vorschau erzeugt.
const titel = 'SCOPERA. | Enterprise AI Platform';
const beschreibung =
  'SCOPERA ist die Enterprise-AI-Plattform der ADVANIS AG für Unternehmen in der Schweiz und DACH. Deutsch oder English.';
const bild = new URL(`${base}bilder/social-share.jpg`, Astro.site);
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
  <link rel="icon" type="image/png" sizes="512x512" href={`${base}favicon.png`} />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  <title>{titel}</title>
  <meta name="description" content={beschreibung} />
  <link rel="canonical" href={new URL(base, Astro.site)} />
  <link rel="alternate" hreflang="de" href={new URL(`${base}de/`, Astro.site)} />
  <link rel="alternate" hreflang="en" href={new URL(`${base}en/`, Astro.site)} />
  <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />
  <meta property="og:title" content={titel} />
  <meta property="og:description" content={beschreibung} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:url" content={new URL(base, Astro.site)} />
  <meta property="og:image" content={bild} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={titel} />
  <meta name="twitter:description" content={beschreibung} />
  <meta name="twitter:image" content={bild} />
  <script is:inline define:vars={{ base }}>
    var ziel = (navigator.language || '').toLowerCase().startsWith('en') ? 'en' : 'de';
    location.replace(base + ziel + '/');
  </script>
  <meta http-equiv="refresh" content={`0; url=${base}de/`} />
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 18px;
      background: #1C1815;
      color: #F3EBDD;
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      text-align: center;
      padding: 24px;
    }
    h1 {
      font-family: Georgia, "Iowan Old Style", "Times New Roman", ui-serif, serif;
      font-size: 32px;
      font-weight: 700;
      margin: 0;
    }
    .dot { color: #C89A55; }
    p { margin: 0; color: #B4A791; max-width: 34em; font-size: 15px; }
    .sprachen { display: flex; gap: 12px; }
    .sprachen a {
      color: #F3EBDD;
      text-decoration: none;
      font-weight: 700;
      font-size: 15px;
      padding: 12px 22px;
      border: 1px solid #F3EBDD;
      border-radius: 6px;
    }
  </style>
</head>
<body>
  <h1>{SITE_NAME}<span class="dot">.</span></h1>
  <p>{beschreibung}</p>
  <div class="sprachen">
    <a href={`${base}de/`}>Deutsch</a>
    <a href={`${base}en/`}>English</a>
  </div>
</body>
</html>
