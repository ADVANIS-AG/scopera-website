---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import SignupBanner from '../../components/SignupBanner.astro';
import HeroBild from '../../components/HeroBild.astro';
import StufenKompakt from '../../components/StufenKompakt.astro';
import NetzGrafik from '../../components/NetzGrafik.astro';
import MandantenGrafik from '../../components/MandantenGrafik.astro';
const features = [
  ['AI Agents', 'Assistenten, die Aufgaben erledigen statt nur antworten: mit Zugriff auf Ihre Daten, Regeln und Systeme.'],
  ['Workflows', 'Automatisierte Abläufe über Systemgrenzen hinweg, von Ihrem Fachbereich selbst konfiguriert, mit Freigaben durch Menschen, wo es darauf ankommt.'],
  ['Knowledge', 'Ihr Firmenwissen, durchsuchbar und nutzbar: Dokumente, Systeme und Erfahrung an einem Ort.'],
  ['Integrationen', 'Microsoft 365, Dynamics 365, SAP, Salesforce und mehr: nahtlos angebunden an das, was Sie schon haben, statt neue Excel-Inseln.'],
  ['Analytics', 'Nutzung, Qualität und Kosten jeder AI-Funktion, transparent im Dashboard.'],
  ['Governance', 'Rollen, Abteilungstrennung, Feldverschlüsselung, revDSG und DSGVO-Werkzeuge. Automatisierte Tests, Backups und Audit-Log inklusive.'],
];
const faelle = [
  { tag: 'Sicherheitstechnik', titel: 'Projektmanagement statt D365-Modul', text: 'Ein Schweizer Sicherheitstechnik-Unternehmen ersetzt sein Dynamics-365-Projektmodul: Offerten mit Kalkulation, Projektstrukturen, Service-Disposition mit mobilem Rapport und Kundenunterschrift, vollständige D365-Integration. Vom Konzept zur getesteten Anwendung in Tagen.' },
  { tag: 'Bauwirtschaft', titel: 'Branchen-Plattform mit Lizenzmodell', text: 'Multi-Tenant-Plattform für die Bauwirtschaft: Onboarding-Wizard, Rollenmodell für alle Beteiligten vom Generalunternehmer bis zum Lieferanten, revDSG und DSGVO-Modul und White-Label-Fähigkeit für Partner.' },
  { tag: 'Human Resources', titel: 'HR-Plattform mit AI-Assistent', text: 'Interne HR-Plattform mit Microsoft-365-Integration, Analytics-Dashboards und AI-Assistent mit Governance-Regeln: Schulungen, Zertifikate und Prozesse an einem Ort.' },
  { tag: 'Portale', titel: 'Self-Service für Kunden und Partner', text: 'Produktionsreife Blaupause für Kundenportale: vier Portale auf einer Plattform, von der öffentlichen Landing Page über Verwaltung und Partnerzugang bis zum Teilnehmerbereich mit Magic-Link-Login.' },
  { tag: 'KMU-Plattform', titel: 'Geschäftspartner, HR und Angebote an einem Ort', text: 'Eine Schweizer KMU verwaltet Geschäftspartner vom Mitbewerber bis zum Kunden und Lieferanten, HR-Daten und Lead-Pipeline in einer Plattform. Automatischer CV- und Angebots-Generator sorgen für einheitliche, professionelle Dokumente.' },
  { tag: 'Event Management', titel: 'Self-Service-Portale für Veranstalter und Teilnehmende', text: 'Eine Event-Management-Applikation mit eigenen Portalen für Veranstaltende und Teilnehmende: dynamische Zusammenstellung von Events und Gruppen, inklusive Networking-Funktionen wie «Treffen Sie unbekannte Teilnehmende und werden Sie zu Event-Freunden».' },
  { tag: 'Salesforce-Migration', titel: 'Alt-Daten und Dokumente mit OCR übernehmen', text: 'Eine Migrationsanwendung übernimmt Alt-Daten und eingescannte Dokumente per OCR-Erkennung strukturiert in die passenden Salesforce-Objekte, ohne manuelle Nacherfassung.' },
  { tag: 'Web & Lead-Management', titel: 'Website mit Besucher-Erkennung und Lead-Pipeline', text: 'Eine moderne Unternehmenswebseite erkennt Firmenbesuche automatisch, bewertet das Interesse und übergibt vielversprechende Kontakte direkt ins CRM, ganz ohne manuelles Nachfassen.' },
  { tag: 'ERP-Migration', titel: 'Alt-ERP zu Dynamics 365 Finance and Operations', text: 'Eine wiederholbare, performante Migrations-Pipeline überführt Daten aus einem Alt-ERP-System strukturiert in Microsoft Dynamics 365 Finance and Operations, mit Fokus auf Datensicherheit und automatisierte Datenkorrektur.' },
  { tag: 'Bauwesen', titel: 'Maschinenverwaltung mit QR-Codes und Erinnerungen', text: 'Für ein Bauunternehmen verwaltet eine Applikation Equipment und Maschinen inklusive QR-Code-Generierung und -Druck sowie automatischem Reminder-Management für Wartung und Prüftermine.' },
  { tag: 'Compliance', titel: 'Compliance Radar mit automatischen Folgeaufgaben', text: 'Ein Compliance Radar wertet laufend die rechtlichen Anforderungen an ein Unternehmen aus und erzeugt daraus automatisch konkrete Folgeaufgaben für C-Level und Mitarbeitende.' },
];
const base = import.meta.env.BASE_URL;
const lang = 'de';
---
<BaseLayout title="Produkt | SCOPERA." description="Die Enterprise AI Platform von SCOPERA: AI Agents, Workflows, Knowledge, Integrationen. Und die Lösungen, die bereits darauf laufen.">
  <section style="padding: 88px 0 64px; border-bottom: none;">
    <div class="wrap">
      <p class="eyebrow">Produkt</p>
      <h1>Sie fangen nie bei null an<span class="dot">.</span></h1>
      <p class="lede">Jede SCOPERA-Lösung steht auf unserer Enterprise AI Platform: erprobt, sicher, White-Label-fähig. Darum geht es schnell, ohne leichtfertig zu sein.</p>
    </div>
  </section>
  <div class="wrap">
    <StufenKompakt lang={lang} aktivPfad="product" einordnung="Das ist die Plattform, auf der ab Stufe 3 gebaut wird." />
    <p class="soft" style="font-size:13px; margin-top:-14px;"><a href={`${base}de/services`}>Für Stufe 1 und 2: Leistungen ansehen →</a></p>
  </div>
  <HeroBild src={`${base}bilder/hero-plattform.jpg`} alt="Beleuchtetes Notenpult mit Partitur, im Hintergrund Musiker im Dunkeln" />
  <section>
    <div class="wrap">
      <p class="eyebrow">Was die Plattform mitbringt</p>
      <h2>Das Fundament jeder Lösung.</h2>
      <p class="soft" style="max-width: 46em;">Jede Funktion ist so gebaut, dass Ihr Fachbereich sie direkt nutzen und anpassen kann, nicht nur die IT.</p>
      <div style="margin: 8px 0 26px;"><NetzGrafik /></div>
      <div class="karten-3">
        {features.map(([t, x]) => (
          <div class="karte">
            <h3>{t}</h3>
            <p style="font-size:14px;" class="soft">{x}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section>
    <div class="wrap">
      <p class="eyebrow">Mandantenfähigkeit</p>
      <h2>Ein Mandant kann eine Abteilung sein.</h2>
      <div style="margin: 8px 0 26px;"><MandantenGrafik /></div>
      <p class="soft" style="max-width: 46em;">Vertrieb, Marketing, HR: Jede Abteilung kann als eigener Mandant auf derselben Datenbasis arbeiten, sauber getrennt, ohne eigene Infrastruktur. Das gleiche Prinzip, mit dem Provider mehrere Kundinnen bedienen, funktioniert auch innerhalb eines einzigen Unternehmens.</p>
      <p style="margin-top:16px;"><a href={`${base}de/partner`}>Mehr zum Provider-Modell →</a></p>
    </div>
  </section>
  <section style="border-bottom: none;">
    <div class="wrap">
      <blockquote class="pull-quote">
        <p>Gute Lösungen erkennt man daran, dass die Nutzer nach einer Woche nicht mehr ohne wollen.</p>
        <cite>Alex, AI Tech Consultant bei SCOPERA</cite>
      </blockquote>
    </div>
  </section>
  <section>
    <div class="wrap">
      <p class="eyebrow">Fallbeispiele</p>
      <h2>Läuft bereits.</h2>
      <div class="karten-2">
        {faelle.map(f => (
          <div class="karte">
            <span class="tag">{f.tag}</span>
            <h3>{f.titel}</h3>
            <p style="font-size:14px;" class="soft">{f.text}</p>
          </div>
        ))}
      </div>
      <p class="soft" style="margin-top:16px; font-size:13px;">Aus Diskretion nennen wir hier keine Kundennamen. Im Gespräch zeigen wir gerne mehr.</p>
    </div>
  </section>
  <CtaBanner lang={lang} titel="Sehen statt glauben." text="Wir zeigen Ihnen die Plattform und ein Fallbeispiel aus Ihrer Branche. Live, nicht auf Folien." />
  
  <div class="wrap">
    <iframe src="https://api.scopera.ai/v1/public/offers/groups/Sommer 2026/banner" width="900" height="568" frameborder="0" style="border:0"></iframe>
  </div>
  <SignupBanner lang={lang} />
</BaseLayout>