---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonaGrid from '../../components/PersonaGrid.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import HeroBild from '../../components/HeroBild.astro';
import KlangLinie from '../../components/KlangLinie.astro';
import VertrauensLeiste from '../../components/VertrauensLeiste.astro';
import StufenBand from '../../components/StufenBand.astro';
import Wegweiser from '../../components/Wegweiser.astro';
import IconFermate from '../../components/icons/IconFermate.astro';
import IconAccelerando from '../../components/icons/IconAccelerando.astro';
import IconBalance from '../../components/icons/IconBalance.astro';
const base = import.meta.env.BASE_URL;
const lang = 'de';
---
<BaseLayout title="SCOPERA. | AI-Lösungen, die einfach laufen" description="AI-Lösungen für Unternehmen in der Schweiz und DACH: von der Strategie bis zum laufenden Betrieb. Geliefert in Wochen, nicht Monaten. SCOPERA — powered by ADVANIS.">
  <section style="padding: 96px 0 72px; border-bottom: none;">
    <div class="wrap">
      <p class="eyebrow">Die Plattform für individuelle Fachprozesse</p>
      <h1>Software, die versteht, wie Sie wirklich arbeiten<span class="dot">.</span></h1>
      <p class="lede">Startklar in Wochen, nicht Monaten. Aus Ihren Fachprozessen werden produktive AI-Anwendungen auf einer abgesicherten Plattform. Beratung buchen Sie dazu, oder unabhängig davon.</p>
      <p style="display:flex; gap:12px; flex-wrap:wrap; margin-top:26px;">
        <a class="btn" href={`${base}de/contact`}>Termin buchen</a>
        <a class="btn-ghost" href={`${base}de/product`}>Was auf der Plattform schon läuft</a>
      </p>
      <div style="margin-top:36px; padding-top:26px; border-top:1px solid var(--line);">
        <VertrauensLeiste lang={lang} />
      </div>
    </div>
  </section>

  <HeroBild src={`${base}bilder/hero-start.jpg`} alt="Vergoldete Kuppeldecke eines historischen Opernhauses mit Kronleuchter und Rängen" />

  <section>
    <div class="wrap">
      <p class="eyebrow">In fünf Stufen</p>
      <h2>So kommen Sie zur Lösung.</h2>
      <StufenBand lang={lang} />
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Ihr Einstieg</p>
      <h2>Wo stehen Sie gerade?</h2>
      <Wegweiser lang={lang} />
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Für wen</p>
      <h2>Wer in Ihrem Unternehmen profitiert.</h2>
      <PersonaGrid lang={lang} />
      <p class="soft" style="margin-top:18px; font-size:14px;">Sind Sie Provider oder Dienstleister? <a href={`${base}de/partner`}>Mehr zum White-Label-Modell →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Warum SCOPERA</p>
      <h2>Schnell. Wirtschaftlich. Sicher und anpassbar. Sie müssen nicht mehr wählen.</h2>
      <div class="karten-3">
        <div class="karte">
          <IconAccelerando />
          <h3>Schnell<span class="dot">.</span></h3>
          <p style="font-size:14px;" class="soft">Prototyp innert Stunden oder Tagen. Produktive Anwendung bei überschaubarem Umfang ab ein bis zwei Wochen.</p>
        </div>
        <div class="karte">
          <IconBalance />
          <h3>Wirtschaftlich<span class="dot">.</span></h3>
          <p style="font-size:14px;" class="soft">Kurze Projektzeiten und keine klassische Lizenzspirale pro Nutzer.</p>
        </div>
        <div class="karte">
          <IconFermate />
          <h3>Sicher und anpassbar<span class="dot">.</span></h3>
          <p style="font-size:14px;" class="soft">Kontrollierter Betrieb und laufende Weiterentwicklung durch autorisierte Personen.</p>
        </div>
      </div>
    </div>
  </section>


  <section style="padding: 40px 0;">
    <div class="wrap">
      <p style="font-size:18px; max-width:46em; border-left:4px solid var(--accent); padding-left:20px; margin:0;">Dieselben Leute, die seit 1997 CRM- und ERP-Projekte für über 300 Schweizer Unternehmen liefern, bauen SCOPERA.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Beweise statt Versprechen</p>
      <h2>Läuft bereits. Bei Unternehmen wie Ihrem.</h2>
      <div class="karten-2">
        <div class="karte">
          <span class="tag">Fallbeispiel</span>
          <h3>Sicherheitstechnik: D365-Projektmodul ersetzt</h3>
          <p style="font-size:14px;" class="soft">Ein Schweizer Sicherheitstechnik-Unternehmen steuert Projekte, Offerten und Service-Einsätze jetzt in einer massgeschneiderten App. Gebaut in Tagen, integriert mit Dynamics 365.</p>
        </div>
        <div class="karte">
          <span class="tag">Plattform</span>
          <h3>Enterprise AI Platform</h3>
          <p style="font-size:14px;" class="soft">Multi-Tenant, AI-Gateway, White-Label-fähig, revDSG- und DSGVO-ready. Das Fundament, auf dem jede unserer Lösungen steht.</p>
        </div>
      </div>
      <p style="margin-top:18px;"><a href={`${base}de/product`}>Zum Produkt und allen Lösungen →</a></p>
    </div>
  </section>

  <section style="border-bottom: none; padding: 56px 0 0;">
    <div class="wrap"><KlangLinie /></div>
  </section>

  <CtaBanner lang={lang} titel="Reden wir über Ihren ersten Use Case." text="30 Minuten genügen, um herauszufinden, wo AI in Ihrem Unternehmen am schnellsten Wirkung zeigt. Unverbindlich, konkret, auf Augenhöhe." />
</BaseLayout>
