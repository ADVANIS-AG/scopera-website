---
const base = import.meta.env.BASE_URL;
const ziel = `${base}de/editions/`;
---
<!doctype html>
<html lang="de-CH">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
  <link rel="icon" type="image/png" sizes="512x512" href={`${base}favicon.png`} />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  <title>Editionen | SCOPERA.</title>
  <link rel="canonical" href={new URL(ziel, Astro.site)} />
  <script is:inline define:vars={{ ziel }}>
    location.replace(ziel);
  </script>
  <meta http-equiv="refresh" content={`0; url=${ziel}`} />
</head>
<body>
  <p>Diese Seite heisst jetzt <a href={ziel}>Editionen</a>.</p>
</body>
</html>
