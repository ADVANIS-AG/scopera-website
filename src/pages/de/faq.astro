---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
const faq = [
  { id: 'tempo', f: 'Wie schnell geht es wirklich?', a: 'Erste sichtbare Resultate sehen Sie innert Stunden, einen funktionsfähigen Prototyp innert Tagen. Die produktive Anwendung folgt bei einfachen Use Cases ab ein bis zwei Wochen, typischerweise innerhalb von zwei bis sechs Wochen, je nach Umfang und Integrationen. Sie sehen von Anfang an Zwischenstände statt Statusberichte.' },
  { id: 'lizenz', f: 'Bin ich an eine Lizenz gebunden?', a: 'Nein. Editionen wählen Sie nach Bedarf, monatlich anpassbar nach oben oder unten. Keine Jahresverträge, keine Lizenz-Zwangsjacke.' },
  { id: 'code', f: 'Wem gehört der Code?', a: 'Das fachliche Wissen bleibt bei Ihnen. Individuelle Entwicklungen gehen in Ihr Eigentum über. Die Plattform nutzen Sie als Lizenz, bei White-Label auch unter Ihrer eigenen Marke.' },
  { id: 'daten', f: 'Wo liegen unsere Daten?', a: 'Standardmässig in der Schweiz. Auf Wunsch in Ihrer eigenen Cloud oder On-Premises. Die Modellwahl (auch Schweizer und europäische Anbieter) treffen wir gemeinsam und dokumentieren sie.' },
  { id: 'it', f: 'Ersetzt ihr unsere IT?', a: 'Nein, wir ergänzen sie. Wir integrieren uns in bestehende Systeme und übergeben so, dass Ihre IT jederzeit mitreden und übernehmen kann.' },
  { id: 'agentic', f: 'Was ist Agentic Engineering?', a: 'Unsere Art zu arbeiten: Wir entwickeln mit AI, auf einer erprobten Plattform, in kurzen Zyklen mit täglich sichtbarem Fortschritt. Sie müssen den Begriff nicht kennen. Sie merken ihn am Tempo.' },
  { id: 'weiterentwicklung', f: 'Wer entwickelt die Lösung nach dem Go-live weiter?', a: 'Sie entscheiden. Betrieb, Sicherheit und Monitoring liegen bei uns. Die fachliche Weiterentwicklung machen Sie im Fachbereich selbst, ohne Softwareentwickler zu sein, oder Sie geben sie an uns. Beides ist möglich und jederzeit änderbar.' },
  { id: 'kosten', f: 'Was kostet der Einstieg?', a: 'Der Starter kostet CHF 20 pro Monat und Mandant, unabhängig von der Nutzerzahl. Assessments und Workshops haben feste Preise, die wir vor dem Start vereinbaren.' },
  { id: 'automatisch', f: 'Ändert sich unsere Lösung von selbst?', a: 'Nein. SCOPERA erkennt Verbesserungspotenzial und schlägt es vor. Was umgesetzt wird, entscheiden autorisierte Personen bei Ihnen. Jede Änderung ist protokolliert und rücksetzbar.' },
];
const lang = 'de';
---
<BaseLayout title="FAQ | SCOPERA." description="Häufige Fragen zu SCOPERA: Tempo, Lizenzmodell, Code-Eigentum, Datenstandort, IT-Integration und Agentic Engineering, klar beantwortet.">
  <section style="padding: 88px 0 64px; border-bottom: none;">
    <div class="wrap">
      <p class="eyebrow">FAQ</p>
      <h1>Klartext<span class="dot">.</span></h1>
      <p class="lede">Die Fragen, die uns am häufigsten gestellt werden, ehrlich beantwortet. Fehlt etwas? Schreiben Sie uns.</p>
    </div>
  </section>
  <section>
    <div class="wrap" style="max-width: 760px;">
      {faq.map(item => (
        <details id={item.id} style="border-top: 1px solid var(--line); padding: 14px 0; scroll-margin-top: 90px;">
          <summary style="font-weight: 700; cursor: pointer; font-size: 17px;">{item.f}</summary>
          <p class="soft" style="margin-top: 10px; max-width: 46em;">{item.a}</p>
        </details>
      ))}
    </div>
  </section>
  <CtaBanner lang={lang} titel="Frage nicht dabei?" text="Schreiben Sie uns direkt oder buchen Sie 30 Minuten. Wir antworten ehrlich, auch wenn die Antwort mal 'nein' ist." />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(item => ({
      '@type': 'Question',
      name: item.f,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  })} />
</BaseLayout>
