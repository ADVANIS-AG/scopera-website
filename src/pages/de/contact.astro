---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { KONTAKT_EMAIL, TELEFON, WORKER_ENDPOINT, TURNSTILE_SITE_KEY, BOOKING_URL } from '../../config';
import HeroBild from '../../components/HeroBild.astro';
const formularAktiv = WORKER_ENDPOINT.length > 0;
const emailAktiv = !KONTAKT_EMAIL.startsWith('PLATZHALTER');
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Kontakt | SCOPERA." description="Termin buchen oder Nachricht schreiben: Der erste Schritt zu Ihrer AI-Lösung dauert 30 Minuten.">
  <section style="padding: 88px 0 64px; border-bottom: none;">
    <div class="wrap">
      <p class="eyebrow">Kontakt</p>
      <h1>Reden wir<span class="dot">.</span></h1>
      <p class="lede">30 Minuten genügen für eine ehrliche Einschätzung: Was ist möglich, was kostet es ungefähr, wie schnell geht es. Unverbindlich.</p>
    </div>
  </section>
  <HeroBild src={`${base}bilder/hero-kontakt.jpg`} alt="Goldverzierte Opernlogen mit Gästen, warm beleuchtet" />
  <section style="border-bottom: none; padding-bottom: 0;">
    <div class="wrap">
      <p style="font-size:17px; font-weight:600; max-width:46em;">Bringen Sie Ihren Fachprozess mit. Gemeinsam prüfen wir, wie SCOPERA ihn digitalisiert.</p>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="karten-3">
        <div class="karte" style="padding: 26px;">
          <h3>Termin buchen</h3>
          <p style="font-size:14px;" class="soft">Der direkteste Weg: Wählen Sie einen Termin, der Ihnen passt.</p>
          {BOOKING_URL
            ? <a class="btn" href={BOOKING_URL}>Termin wählen</a>
            : <p class="soft" style="font-size:14px;"><strong>Online-Buchung folgt in Kürze.</strong> Bis dahin erreichen Sie uns über das Formular{emailAktiv ? ' oder per E-Mail' : ''}.</p>}
        </div>
        <div class="karte" style="padding: 26px;">
          <h3>Anrufen</h3>
          <p style="font-size:14px;" class="soft">Mo–Fr, 08:00–18:00 Uhr.</p>
          <a class="btn" href={`tel:${TELEFON.replace(/\s+/g, '')}`}>{TELEFON}</a>
        </div>
        <div id="nachricht-schreiben" class="karte" style="padding: 26px;">
          <h3>Nachricht schreiben</h3>
          {formularAktiv ? (
            <>
              {TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
              <form id="kontakt-form" style="display:grid; gap:12px;">
                <label style="font-size:13px; font-weight:600;">Name<br /><input name="name" required style="width:100%; padding:10px; border:1px solid var(--line); background:var(--ground); color:var(--ink); font:inherit;" /></label>
                <label style="font-size:13px; font-weight:600;">Firma<br /><input name="firma" style="width:100%; padding:10px; border:1px solid var(--line); background:var(--ground); color:var(--ink); font:inherit;" /></label>
                <label style="font-size:13px; font-weight:600;">E-Mail<br /><input name="email" type="email" required style="width:100%; padding:10px; border:1px solid var(--line); background:var(--ground); color:var(--ink); font:inherit;" /></label>
                <label style="font-size:13px; font-weight:600;">Nachricht<br /><textarea name="nachricht" rows="5" required style="width:100%; padding:10px; border:1px solid var(--line); background:var(--ground); color:var(--ink); font:inherit;"></textarea></label>
                {TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>}
                <button class="btn" type="submit" style="border:none; cursor:pointer;">Senden</button>
                <p id="kontakt-status" class="soft" style="font-size:14px;" hidden></p>
              </form>
              <script is:inline define:vars={{ workerEndpoint: WORKER_ENDPOINT }}>
                const form = document.getElementById('kontakt-form');
                const status = document.getElementById('kontakt-status');
                form?.addEventListener('submit', async (event) => {
                  event.preventDefault();
                  const button = form.querySelector('button[type="submit"]');
                  const data = new FormData(form);
                  const turnstileToken = data.get('cf-turnstile-response') || '';
                  const payload = {
                    name: data.get('name'),
                    firma: data.get('firma'),
                    email: data.get('email'),
                    nachricht: data.get('nachricht'),
                    turnstileToken,
                  };
                  button.setAttribute('disabled', 'true');
                  status.hidden = true;
                  try {
                    const res = await fetch(workerEndpoint + '/contact', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify(payload),
                    });
                    const result = await res.json().catch(() => ({}));
                    if (res.ok && result.ok) {
                      form.reset();
                      status.textContent = 'Danke für Ihre Nachricht. Wir melden uns in Kürze.';
                    } else {
                      status.textContent = 'Das hat leider nicht geklappt. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt.';
                    }
                  } catch {
                    status.textContent = 'Das hat leider nicht geklappt. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt.';
                  } finally {
                    button.removeAttribute('disabled');
                    status.hidden = false;
                  }
                });
              </script>
            </>
          ) : (
            <p class="soft" style="font-size:14px;"><strong>Das Formular wird gerade eingerichtet.</strong> {emailAktiv ? <>Schreiben Sie uns direkt: <a href={`mailto:${KONTAKT_EMAIL}`}>{KONTAKT_EMAIL}</a></> : 'Die Kontaktdaten folgen in Kürze.'}</p>
          )}
        </div>
      </div>
      {emailAktiv && <p class="soft" style="margin-top:18px; font-size:14px;">Oder direkt per E-Mail: <a href={`mailto:${KONTAKT_EMAIL}`}>{KONTAKT_EMAIL}</a></p>}
    </div>
  </section>
  <section>
    <div class="wrap">
      <p class="eyebrow">Ablauf</p>
      <h2>Was in den 30 Minuten passiert.</h2>
      <div class="karten-3" style="margin-bottom:26px;">
        <div class="karte">
          <p class="tag">10 Minuten</p>
          <p style="font-size:14px;" class="soft">Sie schildern den Fachprozess, der Sie stört.</p>
        </div>
        <div class="karte">
          <p class="tag">10 Minuten</p>
          <p style="font-size:14px;" class="soft">Wir zeigen, was auf der Plattform dafür schon existiert.</p>
        </div>
        <div class="karte">
          <p class="tag">10 Minuten</p>
          <p style="font-size:14px;" class="soft">Einschätzung zu Machbarkeit, Dauer und Kostenrahmen.</p>
        </div>
      </div>
      <div class="karten-2">
        <div class="karte">
          <h3>Danach</h3>
          <p style="font-size:14px;" class="soft">Sie erhalten innert zwei Arbeitstagen eine schriftliche Kurzeinschätzung mit Grobkosten. Ob es weitergeht, entscheiden Sie.</p>
        </div>
        <div class="karte">
          <h3>Dabei</h3>
          <div style="display:flex; align-items:center; gap:12px;">
            <div aria-hidden="true" style="flex-shrink:0; width:44px; height:44px; border:1px solid var(--line); background: var(--band); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:17px;">S</div>
            <p style="font-size:14px; margin:0;" class="soft">Sven Brenner, CTO und AI Strategist</p>
          </div>
        </div>
      </div>
      <p class="soft" style="font-size:13px; margin-top:18px;">Nützlich, falls vorhanden: eine Prozessbeschreibung oder ein Beispieldokument.</p>
    </div>
  </section>
</BaseLayout>
