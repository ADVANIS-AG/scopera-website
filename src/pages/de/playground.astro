---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignupBanner from '../../components/SignupBanner.astro';
import { BEISPIELE } from '../../data/beispiele';
const base = import.meta.env.BASE_URL;
const lang = 'de';
const spielwieseUrl = 'https://playground.scopera.ai/playground?lang=de';
const seitenUrl = new URL(`${import.meta.env.BASE_URL}de/playground/`, Astro.site).href;
---
<BaseLayout title="Spielwiese | SCOPERA." description="Beschreib eine Aufgabe aus deinem Alltag. Die Spielwiese baut daraus eine App, die du gleich bedienen kannst, und zeichnet den Ablauf dahinter. Ohne Registrierung.">
  <section style="padding: 88px 0 64px; border-bottom: none;">
    <div class="wrap">
      <p class="eyebrow">Spielwiese</p>
      <h1>Ausprobieren, bevor du dich entscheidest<span class="dot">.</span></h1>
      <p class="lede">Beschreib eine Aufgabe aus deinem Alltag. Die Spielwiese baut daraus eine App, die du gleich hier bedienen kannst, und zeichnet den Ablauf dahinter. Danach schärfst du nach. Ohne Registrierung und ohne eigenen Mandanten.</p>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="spielwiese-embed">
        {/* src wird unten per Skript gesetzt, damit das Theme der Seite von Anfang an stimmt. */}
        <iframe
          id="spielwiese"
          data-src={spielwieseUrl}
          title="SCOPERA Spielwiese"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
      <noscript>
        <p class="soft" style="margin-top:14px; font-size:13px;">Die Spielwiese braucht JavaScript. <a href={spielwieseUrl} target="_blank" rel="noopener noreferrer">Direkt öffnen →</a></p>
      </noscript>
    </div>
  </section>
  <section>
    <div class="wrap">
      <p class="eyebrow">Wie es weitergeht</p>
      <h2>Von der Spielwiese in den eigenen Arbeitsbereich.</h2>
      <p class="soft" style="max-width: 46em;">Gefällt dir, was entstanden ist, übernimmst du es mit «In SCOPERA weiterbauen» in einen eigenen Arbeitsbereich. App und Ablauf stehen dort bereit, sobald du deine E-Mail-Adresse bestätigt hast. Dann bindest du echte Daten an und baust mit deinem Team weiter, mit Rollen, Rechten und Workflows.</p>
      <p style="margin-top:16px;"><a href={`${base}de/product/`}>Was die Plattform sonst mitbringt →</a></p>
    </div>
  </section>
  <section>
    <div class="wrap">
      <p class="eyebrow">Beispiele</p>
      <h2>Womit andere anfangen.</h2>
      <p class="soft" style="max-width: 46em;">Die Spielwiese steigt mit einem dieser Abläufe ein. Jeder zeigt, wie aus Excel, Mail und Papier ein digitaler Prozess wird, auf einer gesicherten Plattform und ohne Schatten-KI.</p>
      <div class="karten-3" style="margin-top: 22px;">
        {BEISPIELE.map((b) => (
          <a class="karte beispiel" href={`${base}de/use-cases/${b.slug}/`}>
            <h3>{b.de.titel}</h3>
            <p class="soft">«{b.de.prompt}»</p>
          </a>
        ))}
      </div>
      <p style="margin-top:16px;"><a href={`${base}de/use-cases/`}>Alle Anwendungsfälle →</a></p>
    </div>
  </section>
  <SignupBanner lang={lang} quelle="playground" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SCOPERA',
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Unternehmensplattform für KI-gestützte Geschäftsprozesse',
    operatingSystem: 'Web',
    url: seitenUrl,
    description: 'Beschreib einen Ablauf aus deinem Alltag in eigenen Worten. SCOPERA baut daraus eine App und den Prozess dahinter, auf einer gesicherten Plattform statt in einem privaten KI-Konto.',
    publisher: { '@type': 'Organization', name: 'ADVANIS AG', url: 'https://www.advanis.ch' },
  })} />
</BaseLayout>
<script>
  const URSPRUNG = 'https://playground.scopera.ai';
  const rahmen = document.getElementById('spielwiese');

  if (rahmen instanceof HTMLIFrameElement && rahmen.dataset.src) {
    // Dunkel ist der Standard der Seite und zeigt sich als Fehlen des Attributs.
    const theme = () => (document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');

    // Das Theme muss immer mitgegeben werden. Ohne den Parameter folgt die Spielwiese dem
    // Betriebssystem, waehrend die Seite ringsum dem eigenen Umschalter folgt. Das Setzen
    // per Skript stellt sicher, dass der Rahmen von Anfang an richtig rendert.
    // Die Seiten der Anwendungsfälle verlinken mit ?example=<id>: die Bühne beginnt dann mit
    // diesem Beispiel. Nur Kleinbuchstaben, alles andere fällt weg.
    const beispiel = new URLSearchParams(window.location.search).get('example') ?? '';
    const mitBeispiel = /^[a-z]{1,24}$/.test(beispiel) ? `&example=${beispiel}` : '';
    rahmen.src = `${rahmen.dataset.src}&theme=${theme()}${mitBeispiel}`;

    const senden = () => {
      rahmen.contentWindow?.postMessage(
        { type: 'scopera:playground:prefs', theme: theme() },
        URSPRUNG, // gezielter Ursprung, nie '*'
      );
    };

    // Beim Laden einmal nachreichen, falls jemand umschaltet, bevor der Rahmen da ist.
    rahmen.addEventListener('load', senden);
    // Beobachter statt eines zweiten Klick-Horchers am Umschalter: greift unabhaengig
    // davon, wodurch das Theme geaendert wurde, und laesst das BaseLayout unberuehrt.
    new MutationObserver(senden).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    // Die Spielwiese meldet ihre Hoehe. Damit waechst der Rahmen mit, sobald jemand einen
    // eigenen Entwurf erzeugt, statt einen eigenen Scrollbalken zu bekommen.
    window.addEventListener('message', (e) => {
      if (e.origin !== URSPRUNG) return;
      const daten = e.data;
      if (!daten || daten.type !== 'scopera:playground:height') return;
      const hoehe = Number(daten.height);
      if (!Number.isFinite(hoehe) || hoehe < 200 || hoehe > 20000) return;
      rahmen.style.minHeight = '0';
      rahmen.style.height = `${hoehe}px`;
    });
  }
</script>
<style>
  .spielwiese-embed {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    /* nur sichtbar, solange der Rahmen noch nicht geladen ist */
    background: var(--card);
  }
  /*
    Keine festen Hoehen: Die Spielwiese meldet ihre Hoehe per postMessage, das Skript oben
    setzt sie. min-height haelt bis zur ersten Meldung den Platz und wird dann aufgehoben.
  */
  .spielwiese-embed iframe { display: block; width: 100%; border: 0; min-height: 820px; }
  .beispiel { display: block; text-decoration: none; color: inherit; transition: border-color .2s; }
  .beispiel:hover { border-color: var(--accent); }
  .beispiel h3 { font-size: 17px; margin: 0 0 8px; }
  .beispiel p { font-size: 14px; margin: 0; }
</style>
