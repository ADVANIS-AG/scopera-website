---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignupBanner from '../../components/SignupBanner.astro';
const base = import.meta.env.BASE_URL;
const lang = 'de';
const spielwieseUrl = 'https://playground.scopera.ai/playground?lang=de';
---
<BaseLayout title="Spielwiese | SCOPERA." description="Beschreiben Sie eine Aufgabe aus Ihrem Alltag. Die Spielwiese entwirft daraus ein Datenmodell, Ansichten, Rollen und einen Ablauf. Ohne Registrierung.">
  <section style="padding: 88px 0 64px; border-bottom: none;">
    <div class="wrap">
      <p class="eyebrow">Spielwiese</p>
      <h1>Ausprobieren, bevor Sie sich entscheiden<span class="dot">.</span></h1>
      <p class="lede">Beschreiben Sie eine Aufgabe aus Ihrem Alltag. Die Spielwiese entwirft daraus ein Datenmodell, Ansichten, Rollen und einen Ablauf. Ohne Registrierung und ohne eigenen Mandanten.</p>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="spielwiese-embed">
        {/* src wird unten per Skript gesetzt, damit das Theme der Seite von Anfang an stimmt. */}
        <iframe
          id="spielwiese"
          data-src={spielwieseUrl}
          title="SCOPERA Spielwiese"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
      <noscript>
        <p class="soft" style="margin-top:14px; font-size:13px;">Die Spielwiese braucht JavaScript. <a href={spielwieseUrl} target="_blank" rel="noopener noreferrer">Direkt öffnen →</a></p>
      </noscript>
    </div>
  </section>
  <section>
    <div class="wrap">
      <p class="eyebrow">Wie es weitergeht</p>
      <h2>Vom Entwurf zur Anwendung.</h2>
      <p class="soft" style="max-width: 46em;">Was hier entsteht, ist ein Entwurf. Im eigenen Mandanten wird daraus eine Anwendung, die Ihr Team benutzen kann, mit Rechten, Verläufen und Auswertungen.</p>
      <p style="margin-top:16px;"><a href={`${base}de/product/`}>Was die Plattform sonst mitbringt →</a></p>
    </div>
  </section>
  <SignupBanner lang={lang} quelle="playground-seite" />
</BaseLayout>
<script>
  const URSPRUNG = 'https://playground.scopera.ai';
  const rahmen = document.getElementById('spielwiese');

  if (rahmen instanceof HTMLIFrameElement && rahmen.dataset.src) {
    // Dunkel ist der Standard der Seite und zeigt sich als Fehlen des Attributs.
    const theme = () => (document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');

    // Das Theme muss immer mitgegeben werden. Ohne den Parameter folgt die Spielwiese dem
    // Betriebssystem, waehrend die Seite ringsum dem eigenen Umschalter folgt. Das Setzen
    // per Skript stellt sicher, dass der Rahmen von Anfang an richtig rendert.
    rahmen.src = `${rahmen.dataset.src}&theme=${theme()}`;

    const senden = () => {
      rahmen.contentWindow?.postMessage(
        { type: 'scopera:playground:prefs', theme: theme() },
        URSPRUNG, // gezielter Ursprung, nie '*'
      );
    };

    // Beim Laden einmal nachreichen, falls jemand umschaltet, bevor der Rahmen da ist.
    rahmen.addEventListener('load', senden);
    // Beobachter statt eines zweiten Klick-Horchers am Umschalter: greift unabhaengig
    // davon, wodurch das Theme geaendert wurde, und laesst das BaseLayout unberuehrt.
    new MutationObserver(senden).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    // Die Spielwiese meldet ihre Hoehe. Damit waechst der Rahmen mit, sobald jemand einen
    // eigenen Entwurf erzeugt, statt einen eigenen Scrollbalken zu bekommen.
    window.addEventListener('message', (e) => {
      if (e.origin !== URSPRUNG) return;
      const daten = e.data;
      if (!daten || daten.type !== 'scopera:playground:height') return;
      const hoehe = Number(daten.height);
      if (!Number.isFinite(hoehe) || hoehe < 200 || hoehe > 20000) return;
      rahmen.style.minHeight = '0';
      rahmen.style.height = `${hoehe}px`;
    });
  }
</script>
<style>
  .spielwiese-embed {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    /* nur sichtbar, solange der Rahmen noch nicht geladen ist */
    background: var(--card);
  }
  /*
    Keine festen Hoehen: Die Spielwiese meldet ihre Hoehe per postMessage, das Skript oben
    setzt sie. min-height haelt bis zur ersten Meldung den Platz und wird dann aufgehoben.
  */
  .spielwiese-embed iframe { display: block; width: 100%; border: 0; min-height: 820px; }
</style>
