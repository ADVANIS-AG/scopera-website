---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import HeroBild from '../../../components/HeroBild.astro';
const artikel = (await getCollection('insights', (e) => e.id.endsWith('/de')))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const datumFmt = new Intl.DateTimeFormat('de-CH', { day: 'numeric', month: 'long', year: 'numeric' });
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Insights | SCOPERA." description="Klartext zu AI im Unternehmen: was funktioniert, was nicht, und woran Sie den Unterschied erkennen.">
  <section style="padding: 88px 0 64px; border-bottom: none;">
    <div class="wrap">
      <p class="eyebrow">Insights</p>
      <h1>Klartext zu AI<span class="dot">.</span></h1>
      <p class="lede">Keine Trends, keine Panik. Was in Schweizer Unternehmen wirklich funktioniert.</p>
    </div>
  </section>
  <HeroBild src={`${base}bilder/hero-insights.jpg`} alt="Schwarz-weiss-Aufnahme eines Orchesters auf der Bühne eines grossen Konzertsaals" />
  <section>
    <div class="wrap">
      {artikel.map(a => (
        <article style="padding: 22px 0; border-top: 1px solid var(--line);">
          {a.data.cover && <Image src={a.data.cover} alt={a.data.coverAlt ?? ''} width={240} style="border-radius: 4px; margin-bottom: 12px;" />}
          <p class="eyebrow">{datumFmt.format(a.data.pubDate)}</p>
          <h2 style="margin: 6px 0 8px;"><a href={`${base}de/insights/${a.id.replace(/\/de$/, '')}`} style="text-decoration:none;">{a.data.title}</a></h2>
          <p class="soft" style="max-width: 46em;">{a.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
