---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
export async function getStaticPaths() {
  const artikel = await getCollection('insights', (e) => e.id.endsWith('/de'));
  return artikel.map(a => ({ params: { slug: a.id.replace(/\/de$/, '') }, props: { a } }));
}
const { a } = Astro.props;
const { Content } = await render(a);
const datumFmt = new Intl.DateTimeFormat('de-CH', { day: 'numeric', month: 'long', year: 'numeric' });
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${a.data.title} | SCOPERA.`} description={a.data.description}>
  <section style="padding: 88px 0 40px;">
    <div class="wrap" style="max-width: 760px;">
      <p class="eyebrow">{datumFmt.format(a.data.pubDate)}</p>
      <h1 style="font-size: clamp(30px, 5vw, 48px);">{a.data.title}</h1>
    </div>
  </section>
  <section style="border-bottom: none;">
    <div class="wrap" style="max-width: 760px; font-size: 17px;">
      {a.data.cover && <Image src={a.data.cover} alt={a.data.coverAlt ?? ''} style="width: 100%; height: auto; border-radius: 4px; margin-bottom: 32px;" />}
      <Content />
      <p style="margin-top: 40px;"><a href={`${base}de/insights`}>← Alle Insights</a></p>
    </div>
  </section>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: a.data.title,
    description: a.data.description,
    datePublished: a.data.pubDate.toISOString(),
    inLanguage: 'de-CH',
    author: { '@type': 'Organization', name: 'SCOPERA' },
    publisher: { '@type': 'Organization', name: 'SCOPERA' },
  })} />
</BaseLayout>
